DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_SOURCE_DATABASE_URL=postgres://powersync_reader:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require&options=-c%20search_path%3Dstaging
PG_SCHEMA=staging
ROUTER_DB_MAX_CONNS=4
ROUTER_DB_MIN_CONNS=1
# Required: /metrics returns 401 without it, and the router refuses to boot
# if this is empty or under 32 chars (fail-closed, metricsCredentialFromEnv
# in services/router/http.go). Generate a real value before first deploy --
# docs/config.md documents the /metrics endpoint and this variable:
#   openssl rand -base64 48
ROUTER_METRICS_TOKEN=
# Every request now arrives through the Cloudflare tunnel, so the router's
# peer address is always the cloudflared container -- without this the per-IP
# rate limiter in httpRateLimit keys every rider in the world to one bucket.
# Trusting the private range lets gin read the real client address out of the
# X-Forwarded-For cloudflared sets. Docker allocates compose networks from
# 172.16.0.0/12 and the subnets are not pinned, so the range is named rather
# than one subnet. Nothing outside the compose networks can reach the router:
# its published ports are loopback-only (BIND_HOST).
ROUTER_TRUSTED_PROXIES=172.30.10.2/32
ROUTING_NETWORK=bus-routing
FUNCTIONS_DB_MAX_CONNS=3
FUNCTIONS_DB_MIN_CONNS=1
REDIS_ADDR=redis:6379
# Required: O7 / review_results.md P2-03 adds --requirepass to Redis. Set a
# real secret before `make up-staging` -- an empty value here disables auth
# again (see env/test.env.example's comment for why that's the intentional
# test-env default).
REDIS_PASSWORD=
# DO NOT set TDX credentials here while staging shares prod's database.
# staging's raw_tdx is prod's raw_tdx (same Azure DB). It has exactly ONE writer
# ONLY because these are empty. Fill them and staging's ingestor would race prod's:
# both run daily partition DELETE/INSERTs against the same raw_tdx and corrupt it.
# When empty, the ingestor skips entirely and issues zero requests (a true no-op);
# staging loads from raw_tdx via the Stage-2 loader. If staging must ingest, point
# it at a SEPARATE database first.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
TRTC_USERNAME=
TRTC_PASSWORD=
# APNs provider key for the pushed tracking-card refresh (ADR-0018). Any of the
# four left empty disables the iOS leg entirely; Android's refresh rides FCM and
# is unaffected. APNS_TOPIC is the app's bundle id (the .push-type.liveactivity
# suffix is added in code). APNS_P8 holds the key's PEM contents, `\n` escapes
# allowed. APNS_SANDBOX=1 targets Apple's sandbox host, where a debug build's
# tokens live.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_P8=
APNS_SANDBOX=
# Two-stage ingestion (ADR-0005): both optional, default off.
LOAD_ON_BOOT=false
INGEST_ON_BOOT=false
# Optional raw-reader DSN for the loader; empty = use DATABASE_URL.
RAW_DATABASE_URL=
CWA_API_KEY=
GOOGLE_MAPS_API_KEY=
API_BASE_URL=https://staging.example.com
POWERSYNC_URL=https://staging.example.com/powersync
GRPC_HOST=staging.example.com
# Staging and prod share one physical host, so their externally-dialed gRPC
# port must differ (50051 is prod's). Update the client's app/env/staging.json
# GRPC_PORT to match if this changes.
GRPC_PORT=51051
GRPC_TLS=true
# gRPC TLS is a transport-layer concern, independent of FIREBASE_ENABLED
# (App Check enforcement). Staging terminates TLS without App Check.
# Cert/key are mounted read-only at /run/secrets by
# docker-compose.staging.yaml, which binds ./secrets/grpc.crt and
# ./secrets/grpc.key individually (not the whole ./secrets directory).
# Required by the router whenever GRPC_TLS=true.
GRPC_TLS_CERT_FILE=/run/secrets/grpc.crt
GRPC_TLS_KEY_FILE=/run/secrets/grpc.key
FIREBASE_ENABLED=false
APP_ENV=staging
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.0
# Chat webhook that new rider feedback reports are announced to (Discord
# incoming-webhook shape). Empty disables the announcement entirely: reports
# are still stored in feedback_thread, nobody is pinged.
FEEDBACK_WEBHOOK_URL=
ARCHIVE_MYSQL_DSN=
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
# Memory budget for the 6 GB host (AGENTS.md): router 256m + functions 768m
# + ingestor 384m + loader 384m + redis 512m + powersync 384m = 2688m for
# staging. Staging runs alongside prod on the same host (see BIND_HOST/port
# comments below), so an operator running both concurrently needs to budget
# for prod's total on top -- reduce these further or stop one environment's
# powersync if that doesn't fit. Staging deliberately runs no MOTIS of its
# own and reaches prod's instead (ADR-0022), which is what keeps the two
# stacks inside the host.
ROUTER_MEM_LIMIT=256m
ROUTER_GOMEMLIMIT=230MiB
FUNCTIONS_MEM_LIMIT=768m
FUNCTIONS_GOMEMLIMIT=680MiB
INGESTOR_MEM_LIMIT=384m
INGESTOR_GOMEMLIMIT=345MiB
LOADER_MEM_LIMIT=384m
LOADER_GOMEMLIMIT=345MiB
# Compose host-port/bind isolation: staging runs alongside prod on the same
# host, so its published ports must not collide with prod's (50051, 8080,
# 8081, 6379, 8082). BIND_HOST defaults every service to loopback; an
# operator fronting staging with a public reverse proxy overrides it.
GRPC_BIND_HOST=127.0.0.1
HTTP_BIND_HOST=127.0.0.1
POWERSYNC_BIND_HOST=127.0.0.1
ROUTER_HTTP_PORT=18080
POWERSYNC_PORT=18081
REDIS_PORT=16379
# Not a staging port: this is the loopback port on the host that prod's MOTIS
# publishes, which staging's router dials through host.docker.internal. It must
# match prod's MOTIS_PORT, not differ from it.
MOTIS_PORT=8082
MOTIS_IMPORT_IMAGE_IDENTITY=ghcr.io/motis-project/motis@sha256:6055f51eec43eeed28524037ca0161b96efe9cd05728eaa9ac04c20c2826d330
GTFS_RT_CREDENTIAL=
GTFS_OUT_DIR=
