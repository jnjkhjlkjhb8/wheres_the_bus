DATABASE_URL=postgres://bus:bus@postgres:5432/bus_test?sslmode=disable
PS_DATABASE_URL=postgres://bus:bus@postgres:5432/bus_test?sslmode=disable
PS_SOURCE_DATABASE_URL=postgres://bus:bus@postgres:5432/bus_test?sslmode=disable
PG_SCHEMA=public
ROUTER_DB_MAX_CONNS=20
ROUTER_DB_MIN_CONNS=2
# Required: /metrics returns 401 without it, and the router refuses to boot
# if this is empty or under 32 chars (fail-closed, metricsCredentialFromEnv
# in services/router/http.go). Generate a real value before first deploy --
# docs/config.md documents the /metrics endpoint and this variable:
#   openssl rand -base64 48
ROUTER_METRICS_TOKEN=
ROUTER_TRUSTED_PROXIES=
ROUTING_NETWORK=bus-test-routing
FUNCTIONS_DB_MAX_CONNS=10
FUNCTIONS_DB_MIN_CONNS=2
REDIS_ADDR=redis:6379
# Empty keeps the local test-env Redis running without --requirepass (O7 /
# review_results.md P2-03) -- docker/docker-compose.yaml's redis command
# passes REDIS_PASSWORD straight through, and an empty --requirepass value
# is treated as "no password", identical to omitting the flag entirely.
REDIS_PASSWORD=
# Only prod's ingestor (ROLE=ingestor) needs TDX credentials; test loads from raw_tdx.
# Empty ⇒ ingestRaw skips entirely and issues zero requests (a true no-op).
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
TRTC_USERNAME=
TRTC_PASSWORD=
# APNs provider key for the pushed tracking-card refresh (ADR-0018). Any of the
# four left empty disables the iOS leg entirely; Android's refresh rides FCM and
# is unaffected. APNS_TOPIC is the app's bundle id (the .push-type.liveactivity
# suffix is added in code). APNS_P8 holds the key's PEM contents, `\n` escapes
# allowed. APNS_SANDBOX=1 targets Apple's sandbox host, where a debug build's
# tokens live.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_P8=
APNS_SANDBOX=
# Two-stage ingestion (ADR-0005): both optional, default off.
LOAD_ON_BOOT=false
INGEST_ON_BOOT=false
# Optional raw-reader DSN for the loader; empty = use DATABASE_URL.
RAW_DATABASE_URL=
CWA_API_KEY=
GOOGLE_MAPS_API_KEY=
API_BASE_URL=http://localhost:8080
POWERSYNC_URL=http://localhost:8081
GRPC_HOST=localhost
GRPC_PORT=50051
GRPC_TLS=false
FIREBASE_ENABLED=false
APP_ENV=test
# Compose host-port/bind isolation (make up-test / up-staging / up-prod pass
# distinct -p project names; these keep host ports from colliding when
# multiple environments run on the same machine). BIND_HOST/GRPC_PORT above
# double as the router's gRPC ingress; the rest default to loopback.
GRPC_BIND_HOST=127.0.0.1
HTTP_BIND_HOST=127.0.0.1
POWERSYNC_BIND_HOST=127.0.0.1
ROUTER_HTTP_PORT=8080
POWERSYNC_PORT=8081
REDIS_PORT=6379
MOTIS_PORT=8082
MOTIS_IMPORT_IMAGE_IDENTITY=ghcr.io/motis-project/motis@sha256:6055f51eec43eeed28524037ca0161b96efe9cd05728eaa9ac04c20c2826d330
POSTGRES_PORT=5432
SENTRY_DSN=
SENTRY_ENVIRONMENT=test
SENTRY_TRACES_SAMPLE_RATE=0.0
# Chat webhook that new rider feedback reports are announced to (Discord
# incoming-webhook shape). Empty disables the announcement entirely: reports
# are still stored in feedback_thread, nobody is pinged.
FEEDBACK_WEBHOOK_URL=
ARCHIVE_MYSQL_DSN=
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
ROUTER_MEM_LIMIT=256m
ROUTER_GOMEMLIMIT=230MiB
FUNCTIONS_MEM_LIMIT=768m
FUNCTIONS_GOMEMLIMIT=680MiB
INGESTOR_MEM_LIMIT=384m
INGESTOR_GOMEMLIMIT=345MiB
LOADER_MEM_LIMIT=384m
LOADER_GOMEMLIMIT=345MiB
GTFS_RT_CREDENTIAL=
GTFS_OUT_DIR=
