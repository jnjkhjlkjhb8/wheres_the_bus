#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Bridges Flutter --dart-define values (e.g. GOOGLE_MAPS_API_KEY_IOS, with
// GOOGLE_MAPS_API_KEY as fallback) into Xcode build settings so
// Info.plist's $(GOOGLE_MAPS_API_KEY_IOS:default=...) resolves at build
// time. Generated by the "Extract Dart Defines" run script build phase from
// the $DART_DEFINES environment variable; absent until the first build runs,
// hence #include? (optional include, no error if missing). Never commit
// Dart-Defines.xcconfig — it contains the resolved secret values. Also used
// for the Profile configuration, which is based on Release.xcconfig.
#include? "Dart-Defines.xcconfig"
